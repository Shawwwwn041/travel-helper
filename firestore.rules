rules_version = '2';

// 旅遊小幫手的資料庫規則
// 原則：1) 沒寫到的一律拒絕  2) 只有本人能讀寫自己的資料  3) 寫進來的資料要通過格式檢查
// 資料結構：users/{uid}/trips/{tripId}/expenses/{expenseId}
service cloud.firestore {
  match /databases/{database}/documents {

    // ---- 共用檢查 ----
    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }
    // 文件 ID：只能是英數字、底線、減號，最長 40 字
    function idOk(id) {
      return id.size() <= 40 && id.matches('^[A-Za-z0-9_-]+$');
    }
    // 文字：一定是字串，而且不超過長度上限
    function text(v, max) {
      return v is string && v.size() <= max;
    }
    // 日期：yyyy-mm-dd
    function day(v) {
      return v is string && v.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
    }
    // 貨幣代碼：三個大寫英文字母，例如 JPY
    function curCode(v) {
      return v is string && v.matches('^[A-Z]{3}$');
    }

    // ---- 使用者本人的抽屜 ----
    match /users/{uid} {
      allow read, delete: if isOwner(uid);
      allow create, update: if isOwner(uid) && validUser(request.resource.data);

      function validUser(d) {
        return d.keys().hasOnly(['name', 'nick', 'avatar', 'lastPick', 'updatedAt'])
          && text(d.get('name', ''), 60)
          // 暱稱：最多 12 字
          && text(d.get('nick', ''), 12)
          // 頭貼：只能是手機上重新壓過的小張 JPEG（data URL），不能是外部網址
          && (!('avatar' in d) || (d.avatar is string && d.avatar.size() <= 60000
                && d.avatar.matches('^data:image/jpeg;base64,[A-Za-z0-9+/=]+$')))
          && d.get('lastPick', {}) is map
          && d.get('lastPick', {}).size() <= 4
          && (d.get('updatedAt', null) == null || d.updatedAt is timestamp);
      }

      // ---- 旅程 ----
      match /trips/{tripId} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid) && idOk(tripId) && validTrip(request.resource.data);

        function validTrip(d) {
          return d.keys().hasAll(['name', 'start', 'end', 'cur', 'accounts'])
            && d.keys().hasOnly(['name', 'dest', 'country', 'start', 'end', 'cur', 'accounts', 'lists', 'sample', 'createdAt', 'updatedAt'])
            && d.name is string && d.name.size() >= 1 && d.name.size() <= 24
            && text(d.get('dest', ''), 12)
            && text(d.get('country', ''), 20)
            && day(d.start) && day(d.end) && d.end >= d.start
            && curCode(d.cur)
            && d.accounts is list && d.accounts.size() <= 20
            // 清單的類別：三個清單（行前待辦、行李、購物）各自最多 30 類
            && (!('lists' in d) || (d.lists is map && d.lists.keys().hasOnly(['todo', 'pack', 'shop'])
                  && d.lists.get('todo', []) is list && d.lists.get('todo', []).size() <= 30
                  && d.lists.get('pack', []) is list && d.lists.get('pack', []).size() <= 30
                  && d.lists.get('shop', []) is list && d.lists.get('shop', []).size() <= 30))
            && d.get('sample', false) is bool
            && (d.get('createdAt', null) == null || d.createdAt is timestamp)
            && (d.get('updatedAt', null) == null || d.updatedAt is timestamp);
        }

        // ---- 清單項目 ----
        match /items/{itemId} {
          allow read, delete: if isOwner(uid);
          allow create, update: if isOwner(uid) && idOk(itemId) && validItem(request.resource.data);

          function validItem(d) {
            return d.keys().hasAll(['list', 'cat', 'name', 'done', 'pos'])
              && d.keys().hasOnly(['list', 'cat', 'name', 'note', 'photo', 'who', 'price', 'paid', 'done', 'pos', 'createdAt', 'updatedAt'])
              && d.list in ['todo', 'pack', 'shop']
              && d.cat is string && d.cat.size() >= 1 && d.cat.size() <= 40
              && d.name is string && d.name.size() >= 1 && d.name.size() <= 60
              && text(d.get('note', ''), 120)
              && d.done is bool
              && d.pos is number
              // 代買／伴手禮：給誰（最多 12 字）、金額（最小單位的整數）、收錢了沒
              && text(d.get('who', ''), 12)
              && (!('price' in d) || (d.price is int && d.price > 0 && d.price < 100000000000000))
              && d.get('paid', false) is bool
              // 照片：只能是手機上重新壓過的 JPEG（data URL），不能是外部網址
              && (!('photo' in d) || (d.photo is string && d.photo.size() <= 380000
                    && d.photo.matches('^data:image/jpeg;base64,[A-Za-z0-9+/=]+$')))
              && (d.get('createdAt', null) == null || d.createdAt is timestamp)
              && (d.get('updatedAt', null) == null || d.updatedAt is timestamp);
          }
        }

        // ---- 記帳 ----
        match /expenses/{expenseId} {
          allow read, delete: if isOwner(uid);
          allow create, update: if isOwner(uid) && idOk(expenseId) && validExpense(request.resource.data);

          function validExpense(d) {
            return d.keys().hasAll(['amount', 'cur', 'rate', 'cat', 'time', 'excluded'])
              && d.keys().hasOnly(['title', 'amount', 'cur', 'rate', 'acct', 'cat', 'time', 'excluded', 'createdAt', 'updatedAt'])
              // 金額：存最小單位的整數（日圓 1 圓、美元 1 分），必須大於 0、有上限
              && d.amount is int && d.amount > 0 && d.amount < 100000000000000
              && curCode(d.cur)
              // 匯率：1 單位約等於幾台幣，必須是合理的正數
              && d.rate is number && d.rate > 0 && d.rate < 1000000
              && text(d.get('title', ''), 40)
              && (d.get('acct', null) == null || text(d.acct, 40))
              && d.cat in ['food', 'shop', 'fun', 'fly', 'move', 'stay', 'other']
              && d.time is timestamp
              && d.excluded is bool
              && (d.get('createdAt', null) == null || d.createdAt is timestamp)
              && (d.get('updatedAt', null) == null || d.updatedAt is timestamp);
          }
        }
      }
    }
  }
}
